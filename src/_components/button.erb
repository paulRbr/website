<%
  sizeStyles = @size == 'full' ? 'w-full' : 'w-fit'
  buttonStyles = "inline-flex data-disabled:opacity-50 items-center justify-center gap-8 border px-20 py-16 cta data-disabled:cursor-default data-disabled:bg-black-300 data-disabled:text-black-900"
  primaryStyles = 'transition-colors rounded-pill border-transparent bg-black-900 text-white hover:bg-black-700 active:hover:bg-black-900'
  buttonVariantStyles = case @variant
  when 'primary'
    primaryStyles
  when 'primary-square'
    primaryStyles + ' rounded-8! py-8!'
  when 'aqua'
    'transition-colors rounded-pill border-transparent bg-aqua-100 text-black-900 hover:bg-aqua-500 active:bg-aqua-600'
  when 'seashell'
    'transition-colors rounded-pill border-transparent bg-seashell-300 text-black-900 hover:bg-seashell-700 active:bg-seashell-800'
  when 'outline'
    'transition-colors rounded-4 border-black-200 bg-white text-black-900 hover:bg-black-100 active:bg-black-200'
  end
  linkStyles = "inline-flex underline-offset-3 data-disabled:opacity-50 items-center justify-center gap-8 p-2 cta text-black-900 hover:not-data-disabled:underline data-disabled:cursor-default active:not-data-disabled:no-underline"
  styles = @variant == 'link' ? "#{linkStyles} #{sizeStyles}" : "#{buttonStyles} #{buttonVariantStyles} #{sizeStyles}"
  attrs = @attributes.map { |key, value| "#{key}=\"#{value}\"" }.join(' ')
%>
<% if @href %>
  <a href="<%= @href %>" class="<%= styles %>" <%=raw attrs %>>
  <% else %>
    <button class="<%= styles %>" <%=raw attrs %>>
    <% end %>
    <%= @text %>
    <% if @icon %>
      <span><%= render Icon.new(@icon, size: 16) %></span>
<% end %>
<% if @href %>
</a>
<% else %>
</button>
<% end %>
