<%
  buttonStyles = "inline-flex data-disabled:opacity-50 items-center justify-center border data-disabled:cursor-default data-disabled:bg-black-300 data-disabled:text-black-900"
  buttonSizeStyles = case @size
  when 'normal'
    'gap-8 px-20 py-16 cta'
  when 'small'
    'gap-8 px-12 py-10 cta'
  when 'very-small'
    'gap-8 px-16 py-6 small-link'
  end
  linkSizeStyles = case @size
  when 'normal'
    'gap-8 py-2 cta'
  when /(very-)?small/
    'gap-4 py-2 small-link'
  end
  widthStyles = @width == 'full' ? 'w-full' : 'w-fit'
  primaryStyles = 'transition-colors rounded-pill border-transparent bg-black-900 text-white hover:bg-black-700 active:bg-black-900'
  buttonVariantStyles = case @variant
  when 'primary'
    primaryStyles
  when 'primary-square'
    primaryStyles + ' rounded-8! py-8!'
  when 'primary-light'
    'transition-colors rounded-pill border-transparent bg-black-700 text-white hover:bg-black-800 active:hover:bg-black-900'
  when 'aqua'
    'transition-colors rounded-pill border-transparent bg-aqua-100 text-black-900 hover:bg-aqua-500 active:bg-aqua-600'
  when 'seashell'
    'transition-colors rounded-pill border-transparent bg-seashell-300 text-black-900 hover:bg-seashell-700 active:bg-seashell-800'
  when 'outline'
    'transition-colors rounded-pill border-black-200 bg-white text-black-900 hover:bg-black-100 active:bg-black-200'
  when 'outline-square'
    'transition-colors rounded-4 border-black-200 bg-white text-black-900 hover:bg-black-100 active:bg-black-200'
  end
  linkStyles = "inline-flex underline-offset-3 data-disabled:opacity-50 items-center justify-center  hover:not-data-disabled:underline data-disabled:cursor-default active:not-data-disabled:no-underline"
  linkVariantStyles = case @variant
  when 'link'
    linkStyles + ' text-black-900'
  when 'link-white'
    linkStyles + ' text-white'
  end
  styles = if @variant == 'link' || @variant == 'link-white'
    "#{linkStyles} #{linkVariantStyles} #{linkSizeStyles} #{widthStyles}"
  else
    "#{buttonStyles} #{buttonVariantStyles} #{buttonSizeStyles} #{widthStyles}"
  end
  attrs = @attributes.map { |key, value| "#{key}=\"#{value}\"" }.join(' ')
%>
<% if @href %>
  <a href="<%= @href %>" class="<%= styles %> <%= @dangerous_classes %>" <%=raw attrs %>>
  <% else %>
    <button class="<%= styles %> <%= @dangerous_classes %>" <%=raw attrs %>>
    <% end %>
    <%= @text %>
    <% if @icon %>
      <span><%= render Icon.new(@icon, size: 16) %></span>
<% end %>
<% if @href %>
</a>
<% else %>
</button>
<% end %>
