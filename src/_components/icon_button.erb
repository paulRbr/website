<%
  buttonStyles = "inline-flex leading-none self-center rounded-full data-disabled:opacity-50 items-center justify-center gap-2 p-[9px] w-32 h-32 cta data-disabled:cursor-default data-disabled:bg-black-300 data-disabled:text-black-900"
  buttonVariantStyles = case @variant
  when 'primary'
    'bg-black-900 text-white hover:bg-black-700'
  when 'seashell'
    'bg-seashell-300 text-black-900 hover:bg-seashell-700'
  end
  styles = "#{buttonStyles} #{buttonVariantStyles}"
  attrs = @attributes.map { |key, value| "#{key}=\"#{value}\"" }.join(' ')
%>
<% if @href %>
  <a href="<%= @href %>" class="<%= styles %>" <%=raw attrs %>>
  <% else %>
    <button class="<%= styles %>" <%=raw attrs %>>
    <% end %>
    <%= render Icon.new(@icon, size: 14) %>
  <% if @href %>
  </a>
  <% else %>
  </button>
<% end %>
