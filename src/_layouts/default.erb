<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <%= render "head", metadata: site.metadata, title: data.title %>
  </head>
  <body
    class="bg-white text-black-900 <%= data.layout %> <%= data.page_class %>"
    style="background: linear-gradient(358.18deg, rgba(249, 253, 253, 0) -0.97%, #F7FDFE 28.76%, #F4FDFF 98.13%);"
  >
    <%= render "header/header", metadata: site.metadata, resource: resource %>

    <main>
      <%= yield %>
    </main>

    <%= render "footer", metadata: site.metadata %>
    <%= render "foot" %>
  </body>
</html>
