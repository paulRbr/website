---
layout: default
---
<% slot :skip_links do %>
  <%= render 'skip_link', href: '#content', title: 'content' %>
  <%= render 'skip_link', href: '#post', title: 'post' %>
  <%= render 'skip_link', href: '#footer', title: 'footer' %>
<% end %>

<% slot :head_meta do %>
  <% if resource.relations.team_member %>
    <meta property="article:author" content="<%= resource.relations.team_member.data.name %>">
  <% elsif data.author %>
    <meta property="article:author" content="<%= data.author %>">
  <% end %>
<% end %>

<% slot :opengraph_image do %>
  <% og_img = resource.data.image %>
  <% if og_img %>
    <meta property="og:image" name="image" content="<%= og_img.start_with?('http') ? og_img : "#{site.config.url}/website/images/#{og_img.gsub(/^\//, '')}" %>">
  <% end %>
<% end %>

<%= render "with_dots_bg",
  classes: "-mt-navbar pt-navbar pb-section aqua-gradient" do %>
  <div class="container-main mt-section">
    <%= render 'section_heading', locals: {
      title: data.title,
      lvl: 1
    } do %>
      <div class="flex flex-col items-center gap-16">
        <% if defined?(data.category) %>
          <%= render Tag.new data.category %>
        <% end %>
        <p class="body-4"><%= data.date.strftime('%m/%d/%Y') %></p>
      </div>
    <% end %>

    <div class="flex justify-between items-center gap-16 pb-24 border-b border-black-300">
      <% if resource.relations.team_member %>
        <%= render 'person_avatar', locals: {
          name: resource.relations.team_member.data.name,
          image: "/website/images/team_members/#{resource.relations.team_member.data.slug}.png"
        } %>
      <% elsif data.author %>
        <%= render 'person_avatar', locals: {
          name: data.author,
        } %>
      <% else %>
        <span></span>
      <% end %>
      <p class="body-3 flex items-center gap-8">
        <span class="relative top-[1px] w-4 h-4 rounded-full bg-current"></span>
        <%= reading_time content %>
      </p>
    </div>
  </div>
<% end %>

<div class="container-main mb-section relative">
  <div class="flex flex-col lg:flex-row gap-32">
    <div class="lg:w-3/12">
      <div class="sticky top-navbar">
        <div class="flex flex-col gap-24 pb-0 lg:pb-24 lg:border-b border-black-300">
          <%= render "page_blog/company_info", company: resource.data.company if defined?(resource.data.company) %>
          <%= render 'toc', toc: toc(markdownify(content)) %>
          <div class="hidden lg:block">
            <%= render 'share_page' %>
          </div>
        </div>
        <div class="hidden lg:block mt-24">
          <% cta = defined?(data.cta) && data.cta.title && data.cta.href ? data.cta : {
            title: 'Book your demo now',
            description: 'Schedule a call with our team',
            href: calendly_url
          } %>
          <%# little padding to align the card with the bottom of the article content (we need it because the big content line-height creates a gap at the end) %>
          <div style="padding-bottom: 4px"><%= render 'cta_card', **cta %></div>
        </div>
      </div>
    </div>
    <div class="lg:w-9/12">
      <article id="post" class="cms">
        <%= yield %>
      </article>
      <div class="lg:hidden">
        <%= render 'share_page' %>
      </div>
    </div>
  </div>
</div>

<div class="container-main my-section2x">
  <% if resource.data.related_posts %>
    <%= render 'section_heading', locals: {
      title: 'Related articles',
      description: 'We think you might like these articles too.',
      lvl: 2,
      # just force an empty content variable to avoid the partial to take the post `content`
      # (I just didn't find how to handle this in a cleaner way by looking at bridgetown docs and code)
      content: ''
    } %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-32 mx-auto w-fit">
      <% resource.data.related_posts.each do |related_post| %>
        <%= render 'post_excerpt', locals: {
          **related_post.data,
          "lvl" => 3,
          "href" => related_post.relative_url,
          "excerpt" => post_excerpt(markdownify(related_post.content)),
          "image" => defined?(related_post.data.image) ? '/website/images/' + related_post.data.image : nil
        } %>
      <% end %>
    </div>
  <% end %>
</div>

<% slot :stylesheets do %>
  <link rel="stylesheet" href="/website<%= asset_path 'styles/pygment-monokai.css' %>" />
<% end %>

<% slot :scripts do %>
  <script src="/website<%= asset_path 'javascript/pages/post/index.js' %>"></script>
<% end %>
