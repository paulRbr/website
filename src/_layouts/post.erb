---
layout: default
---
<%= render "with_dots_bg",
  classes: "-mt-navbar pt-navbar pb-section aqua-gradient" do %>
  <div class="container-main mt-section">
    <%= render 'section_heading', locals: {
      title: data.title,
      lvl: 1
    } do %>
      <div class="flex flex-col items-center gap-16">
        <% if defined?(data.category) %>
          <%= render Tag.new data.category %>
        <% end %>
        <p class="body-4"><%= data.date.strftime('%m/%d/%Y') %></p>
      </div>
    <% end %>

    <div class="flex justify-between items-center gap-16 pb-24 border-b border-black-300">
      <% if resource.relations.team_member %>
        <%= render 'person_avatar', locals: {
          name: resource.relations.team_member.data.name,
          image: "/images/team_members/#{resource.relations.team_member.data.slug}.png"
        } %>
      <% elsif data.author %>
        <%= render 'person_avatar', locals: {
          name: data.author,
        } %>
      <% else %>
        <span></span>
      <% end %>
      <p class="body-3 flex items-center gap-8">
        <span class="relative top-[1px] w-4 h-4 rounded-full bg-current"></span>
        <%= reading_time content %>
      </p>
    </div>
  </div>
<% end %>

<div class="container-main mb-section2x">
  <div class="cms">
    <%= yield %>
  </div>
</div>

<% slot :stylesheets do %>
  <link rel="stylesheet" href="<%= asset_path 'styles/pygment-monokai.css' %>" />
<% end %>
