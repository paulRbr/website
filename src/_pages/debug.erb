<%# Just a page to test tailwind classes, components, partials, etc. %>
<div class="p-4" style="margin-bottom: 300px">
  <div class="pb-20">
    <div class="h1">Typography</div>
    <h1 class="h1">Heading 1</h1>
    <h2 class="h2">Heading 2</h2>
    <h3 class="h3">Heading 3</h3>
    <h4 class="h4">Heading 4</h4>
    <h5 class="h5">Heading 5</h5>
    <h6 class="h6">Heading 6</h6>
    <p class="font-sans">Sans font. <br/>
      Lorem, ipsum dolor sit amet consectetur adipisicing elit. Voluptates ipsum ad labore molestias cupiditate, neque dignissimos, reiciendis sed hic fugit reprehenderit iusto rerum aut nesciunt numquam placeat ratione delectus atque.
    </p>
    <pre><code class="font-mono">Mono font.<br/>
struct group_info init_groups = { .usage = ATOMIC_INIT(2) };
struct group_info *groups_alloc(int gidsetsize){
struct group_info *group_info;
int nblocks;
int i</code></pre>
    <p class="vfont-regular">Regular weight text</p>
    <p class="vfont-medium">Medium weight text</p>
    <p class="vfont-semibold">Semibold weight text</p>
  </div>
  <div class="py-20">
    <div class="h1">Buttons</div>
    <div class="flex gap-4 mb-20">
      <%= render Button.new 'Primary button', variant: 'primary' %>
      <%= render Button.new 'Primary button (disabled)', variant: 'primary', disabled: true %>
      <%= render Button.new 'Aqua button', variant: 'aqua' %>
      <%= render Button.new 'Seashell button', variant: 'seashell' %>
      <%= render Button.new 'Outline button', variant: 'outline' %>
      <%= render Button.new 'Link button', variant: 'link' %>
      <%= render Button.new 'Link button (disabled)', variant: 'link', disabled: true %>
    </div>
    <div class="flex gap-4">
      <%= render Button.new 'Primary link', href: '#', variant: 'primary' %>
      <%= render Button.new 'Primary link (disabled)', href: '#', variant: 'primary', disabled: true %>
      <%= render Button.new 'Aqua link', href: '#', variant: 'aqua' %>
      <%= render Button.new 'Seashell link', href: '#', variant: 'seashell' %>
      <%= render Button.new 'Outline link', href: '#', variant: 'outline' %>
      <%= render Link.new 'Link link', href: '#' %>
      <%= render Link.new 'Link link (disabled)', href: '#', disabled: true %>
    </div>
  </div>
  <div class="py-20">
    <div class="h2">Buttons row</div>
    <div class="buttons-row">
      <%= render Button.new 'Primary button', variant: 'primary' %>
      <%= render Button.new 'Primary button (disabled)', variant: 'primary', disabled: true %>
    </div>
  </div>
  <div class="py-20">
    <div class="h2">Button icons</div>
    <div class="buttons-row">
    </div>
  </div>
  <div class="py-20">
    <div class="h2">Tags</div>
    <div class="flex gap-4 items-center">
      <%= render Tag.new 'This is a pill title', icon: 'arrow-right-up-line', variant: 'pill' %>
      <%= render Tag.new 'This is a tag', icon: 'arrow-right-up-line', variant: 'square' %>
      <%= render Tag.new 'This is an tag', icon: 'arrow-right-up-line', variant: 'aqua' %>
      <%= render Tag.new 'This is a tag', icon: 'arrow-right-up-line', variant: 'seashell' %>
    </div>
  </div>
</div>