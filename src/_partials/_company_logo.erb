<% if image.end_with?('.svg') %>
  <%= svg image, class: "w-auto relative #{locals[:classes]}", style: "height: #{locals[:height]}px;", **(locals[:label] ? { role: "img", "aria-label": locals[:label] } : { "aria-hidden": true }) %>
<% else %>
  <img
    loading="lazy"
    <%== image_attrs image, {height: locals[:height], responsive: false} %>
    alt="<%= locals[:label] || "" %>"
    style="height: <%= locals[:height] %>px;"
    class="w-auto relative <%= locals[:classes] %>"
  >
<% end %>