<% link_lists = [
  {
    title: 'Compare',
    links: collections.alternatives.resources.map { |alternative|
      {title: alternative.data.short_title, href: "/alternative/#{alternative.data.slug}"}
    }
  },
  {
    title: 'Information',
    links: [
      { title: 'Pricing', href: '/pricing' },
      { title: 'About', href: '/about' },
      { title: 'Careers', href: '/about#careers' },
    ]
  },
  {
    title: 'Resources',
    links: [
      { title: 'Customers', href: '#' },
      { title: 'Blog', href: '/blog' },
      { title: 'Help center', href: 'https://docs.bump.sh/help' },
      { title: 'CLI', href: 'https://docs.bump.sh/help/continuous-integration/cli/' },
      { title: 'Status', href: 'https://status.bump.sh/' },
      { title: 'Contact', href: 'mailto:hello@bump.sh' },
    ]
  }
] %>
<% legal_links = [
  { title: 'Privacy Policy', href: '/privacy-policy' },
  { title: 'Legal mentions', href: '/legal-mentions' },
  { title: 'Terms of use', href: '/terms' },
  { title: 'Data Processing Agreement', href: '/dpa' },
  { title: 'Cookie Policy', href: '/cookie-policy' },
] %>
<% social_links = [
  { title: 'Twitter', href: '#', icon: 'twitter-x-line' },
  { title: 'Instagram', href: '#', icon: 'instagram-line' },
  { title: 'LinkedIn', href: '#', icon: 'linkedin-box-fill' },
] %>

<div id="footer" class="bg-black-50 pb-section relative">
  <%= render "with_dots_bg", classes: "pt-section" do %>
    <div class="container-main">
      <%= render "section_heading", locals: {
        title: 'Your APIs are critical, your docs should be too.',
        description: 'Let’s talk. Your success starts with sharing what you need.',
      } do %>
        <%= render Button.new 'Get a demo', href: '#', icon: 'arrow-right-up-line' %>
      <% end %>
    </div>
  <% end %>

  <footer class="container-main" role="contentinfo">
    <%# have a heading helping screen reader users. Use role heading instead of h2 to not impact SEO %>
    <div role="heading" aria-level="2" class="sr-only">Footer</div>

    <div class="flex flex-col sm:items-center md:items-start md:flex-row gap-32 justify-between border-t border-black-200 pt-64 pb-16">
      <div class="flex flex-col gap-48">
        <div class="flex flex-col gap-16 sm:items-center md:items-start">
          <img
            loading="lazy"
            src="/images/logo.svg"
            width="147"
            height="33"
            alt="Bump.sh"
          >
          <p class="body-3 text-black-900">The modern API doc platform</p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row flex-wrap gap-32 pl-120">
        <% link_lists.each do |link_list| %>
          <div class="w-[10.75rem] flex-auto flex flex-col sm:items-center md:items-start gap-16">
            <%# Use role heading instead of h3 to not impact SEO %>
            <div role="heading" aria-level="3" class="capped-small text-black-600"><%= link_list[:title] %></div>
            <ul role="list" class="flex flex-col sm:items-center md:items-start gap-8">
              <% link_list[:links].each do |link| %>
                <li><a href="<%= link[:href] %>" class="text-black-700 small-link hover:underline active:no-underline underline-offset-2"><%= link[:title] %></a></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex flex-col md:flex-row gap-32 justify-between md:items-end py-16">
      <div class="flex flex-col gap-32 sm:items-center md:items-start">
        <div class="flex gap-24">
          <% social_links.each do |social_link| %>
            <a href="<%= social_link[:href] %>" aria-label="<%= social_link[:title] %>" class="p-8 rounded-8 transition-colors hover:bg-black-100 active:bg-black-300">
              <%= render Icon.new social_link[:icon], size: 20, classes: "text-black-600" %>
            </a>
          <% end %>
        </div>
        <p class="text-black-600 body-4">© 2025 Bump.sh. All rights reserved.</p>
      </div>

      <ul role="list" class="flex flex-col gap-16 md:flex-row flex-wrap md:gap-32 sm:items-center md:items-start">
        <% legal_links.each do |link| %>
          <li><a href="<%= link[:href] %>" class="text-black-600 small-link hover:underline active:no-underline underline-offset-2"><%= link[:title] %></a></li>
        <% end %>
      </ul>
    </div>
  </footer>
</div>
