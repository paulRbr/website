<%#
  Page section heading, with a small monospace uppercase, a bold title and a description

  Params (all required):
    - title: section title
    - pill: section pill
    - description: section description
%>
<div class="flex flex-col items-center justify-center w-full my-section gap-40">
  <div class="flex flex-col items-center justify-center w-full gap-24">
    <div class="flex flex-col items-center justify-center w-full gap-12">
      <h2 class="h2 text-black-900 text-center"><%= title %></h2>
      <p class="capped-small order-first text-aqua-700"><%= pill %></p>
    </div>
    <p class="body-2 text-black-900 text-center max-w-[42rem]"><%= description %></p>
  </div>
</div>