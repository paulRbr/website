<%#
  Page section heading, with a small monospace uppercase 'category' label, a bold title and a description

  Params:
    - title (required): section title
    - pill (optional): section pill
    - description (optional): section description
    - variant (optional): "dark" or nothing. Default to light theme when omitted
    - lvl (optional) number from 1 to 6 to set the heading level. Default to 2.
  Can also be passed the default content slot, which will be rendered below the description, mostly used to render a button for now
%>
<% variant = variant || 'light' %>
<% lvl = lvl || 2 %>
<div class="mb-section" <%= "id=\"#{id}\"".html_safe if defined?(id) %>>
  <div class="flex flex-col sm:items-center justify-center w-full gap-24">
    <div class="flex flex-col sm:items-center justify-center w-full gap-12">
      <%# h1 h2 h3 h4 h5 h6 are generated classes %>
      <h<%= lvl %> class="h<%= lvl %> text-balance sm:text-center <%= variant == 'dark' ? 'text-white' : 'text-black-900' %> <%= additional_classes if defined?(additional_classes) %>">
        <%= title %>
      </h<%= lvl %>>
      <% if defined?(pill) && pill %>
        <p class="capped-small order-first <%= variant == 'dark' ? 'text-white' : 'text-aqua-900' %>"><%= pill %></p>
      <% end %>
    </div>
    <% if defined?(description) %>
      <p class="body-1 text-balance <%= variant == 'dark' ? 'text-white' : 'text-black-900' %> sm:text-center md:max-w-[42rem]">
        <%= description %>
      </p>
    <% end %>
    <% if content && !content.empty? %>
      <div class="mt-16">
        <%= content %>
      </div>
    <% end %>
  </div>
</div>
