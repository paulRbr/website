<li class="flex flex-col gap-8 %>">
  <a
    href="#<%= item[:id] %>"
    class="js-tocItem small-link text-black-800 inline-flex items-start gap-8 group/toc-item"
  >
    <%= render Icon.new 'bookmark', size: 21, classes: 'text-black-400! group-data-current/toc-item:text-black-800! transition-colors duration-300' %>
    <%= item[:text] %>
  </a>
  <% if item[:children] %>
    <ul class="flex flex-col gap-8 pl-12">
      <% item[:children].each do |child| %>
        <%= render 'toc_item', item: child, root: false %>
      <% end %>
    </ul>
  <% end %>
</li>
