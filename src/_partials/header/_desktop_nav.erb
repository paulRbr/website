<% dropdown_styles = 'js-navDropdownContent hidden border border-t-0 border-black-100 opacity-0 absolute -mt-1 -mx-1 top-full z-30 left-0 right-0 w-full bg-white p-24 gap-16'%>
<style>
  .js-headerContent:hover .js-desktopNav > ul > li:not([data-open]) > :is(a, button):not(:hover) {
    opacity: 0.6;
  }
</style>
<nav aria-label="Main navigation" role="navigation" class="hidden md:block js-desktopNav">
  <ul role="list" class="navItems flex gap-12">
    <% menu_items.each do |item| %>
      <li>
        <%= render 'header/desktop_nav_item', title: item[:title], href: item[:href], dropdown: !!item[:submenu] %>

        <% if item[:submenu] %>
          <div style="width: calc(100% + 2px)" class="<%= dropdown_styles %>">

            <%# specific submenu content for some items are handled here. These are not rendered in the mobile menu %>
            <% if item[:title] === 'Resources' %>
              <div class="w-[17.625rem] p-24 bg-black-50 text-black-600 mt-32 rounded-8 flex flex-col">
                <h2 class="other-link text-black-900 mb-8">
                  Want a personalized product tour?
                </h2>
                <p class="body-3 mb-24">
                  Short explanation sentence here
                </p>
                <div class="mt-auto">
                  <%= render Button.new 'Request demo', variant: 'primary', href: '#' %>
                </div>
              </div>
            <% end %>

            <div class="<%= item[:submenu][:layout] === 'grid' ? '' : 'flex flex-col gap-16' %>">
              <h2 class="capped-small text-black-600">
                <%= item[:submenu][:title] %>
              </h2>
              <ul role="list" class="<%= item[:submenu][:layout] === 'grid' ? 'grid grid-cols-2 gap-16 mt-20' : 'flex gap-16' %>">
                <% item[:submenu][:items].each do |sub_item| %>
                  <%= render 'header/desktop_nav_sub_item', **sub_item %>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>

<nav aria-label="Account navigation" class="hidden md:block js-desktopNav">
  <ul role="list" class="flex gap-12">
    <li><%= render 'header/desktop_nav_item', title: 'Login', href: '/login' %></li>
    <li><%= render 'header/desktop_nav_item', title: 'Sign up', href: '/signup' %></li>
  </ul>
</nav>