<%#
  Desktop header bar

  Params: none
%>
<% base_styles = 'fixed top-0 left-0 right-0 z-50 flex my-16 px-24 bg-transparent border border-transparent justify-between rounded-tl-8 rounded-tr-8 items-center w-main mx-auto transition-all' %>
<% fixed_styles = 'data-fixed:backdrop-blur-8 data-fixed:bg-white/70 data-fixed:border-black-300 data-fixed:shadow-nav' %>
<% hover_styles = 'hover:bg-white! hover:border-black-100!' %>

<div class="js-headerPositionTracker" aria-hidden="true"></div>
<div
  class="js-header <%= base_styles %> <%= fixed_styles %> <%= hover_styles %>"
>
  <header>
    <a href="<%= relative_url '/' %>">
      <img src="<%= relative_url '/images/logo.svg' %>" alt="Bump.sh" />
    </a>
  </header>

  <%= render 'header/nav' %>

  <nav aria-label="Account navigation">
    <ul role="list" class="flex gap-12">
      <li><%= render 'header/nav_item', title: 'Login', href: '/login' %></li>
      <li><%= render 'header/nav_item', title: 'Sign up', href: '/signup' %></li>
    </ul>
  </nav>
</div>
