<% dropdown_styles = 'js-navDropdownContent -mx-1 hidden border border-t-0 border-black-100 opacity-0 absolute top-full z-0 left-0 w-full bg-white p-24 gap-16'%>
<style>
  .navItems:hover > li:not([data-open]) > :is(a, button):not(:hover) {
    opacity: 0.5;
  }
</style>
<nav aria-label="Main navigation">
  <ul role="list" class="navItems flex gap-12">
    <li><%= render 'header/nav_item', title: 'Pricing', href: '/pricing' %></li>
    <li><%= render 'header/nav_item', title: 'Product', href: '/product' %></li>
    <li>
      <%= render 'header/nav_item', title: 'Resources', dropdown: true %>
      <div style="width: calc(100% + 2px)" class="<%= dropdown_styles %>">
        <div class="w-[17.625rem] p-24 bg-black-50 text-black-600 mt-32 rounded-8 flex flex-col">
          <h2 class="other-link text-black-900 mb-8">
            Want a personalized product tour?
          </h2>
          <p class="body-3 mb-24">
            Short explanation sentence here
          </p>
          <div class="mt-auto">
            <%= render Button.new 'Request demo', variant: 'primary', href: '#' %>
          </div>
        </div>
        <div>
          <h2 class="capped-small text-black-600">All ressources</h2>
          <ul role="list" class="grid grid-cols-2 gap-16 mt-20">
            <% resource_items = [
              {
                title: 'About',
                icon: 'arrow-right',
                href: '/about',
                description: 'Short explanation sentence here'
              },
              {
                title: 'Blog',
                icon: 'arrow-right',
                href: '/blog',
                description: 'Short explanation sentence here'
              },
              {
                title: 'Careers',
                icon: 'arrow-right',
                href: '/careers',
                description: 'Short explanation sentence here'
              },
              {
                title: 'Customers',
                icon: 'arrow-right',
                href: '/customers',
                description: 'Short explanation sentence here'
              }
            ] %>
            <% resource_items.each do |item| %>
              <%= render 'header/nav_sub_item', **item %>
            <% end %>
          </ul>
        </div>
      </div>
    </li>
    <li>
      <%= render 'header/nav_item', title: 'Documentation', href: '/documentation', dropdown: true %>
      <div style="width: calc(100% + 2px)" class="<%= dropdown_styles %>">
        <div class="flex flex-col gap-16">
          <div class="flex gap-8">
            <h2 class="capped-small text-black-600">All documentation</h2>
          </div>
          <ul role="list" class="flex gap-16">
            <% doc_items = [
              {
                title: 'Help center',
                icon: 'arrow-down',
                href: '/help-center',
                description: 'Short explanation sentence here'
              },
              {
                title: 'API Reference',
                icon: 'arrow-down',
                href: '/api-reference',
                description: 'Short explanation sentence here'
              },
              {
                title: 'API Management Encyclopedia',
                icon: 'arrow-down',
                href: '/api-encyclopedia',
                description: 'Short explanation sentence here'
              },
              {
                title: 'Status',
                icon: 'arrow-down',
                href: '/status',
                description: 'Short explanation sentence here'
              }
            ] %>
            <% doc_items.each do |item| %>
              <%= render 'header/nav_sub_item', **item %>
            <% end %>
          </ul>
        </div>
      </div>
    </li>
  </ul>
</nav>