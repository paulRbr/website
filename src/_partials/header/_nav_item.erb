<%#
  Desktop header navbar top level item

  Params:
    - title (required)
    - href (optional if dropdown is true, required otherwise)
    - dropdown (optional, default: false), set to true to render a button with an arrow icon
%>
<% if defined?(dropdown) && dropdown %>
  <button class="js-nav-dropdown-toggle flex items-center gap-4 small-link py-16 px-4">
    <span><%= title %></span>
    <%= render Icon.new 'arrow-down', size: 12, classes: 'js-nav-dropdown-toggle-icon relative top-[2px]' %>
  </button>
<% else %>
  <a class="block small-link py-16 px-4" href="<%= href %>"><%= title %></a>
<% end %>
