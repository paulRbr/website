<%#
  Bento item, used for example on the homepage (dark theme)

  Params:
    - icon (required): icon name
    - title (required): title
    - description (required): small text description appearing below the title
  Slots:
    - right_column (optional): slot for additional html content showing on the right side of the item
%>
<div class="bg-black-800 rounded-12 p-24 flex <%= slotted?(:right_column) ? "gap-24" : "flex-col gap-8" %>">
  <div class="<%= slotted?(:right_column) ? "w-1/2" : "" %> flex flex-col gap-8">
    <div class="flex flex-col gap-8">
      <%= render Icon.new icon, class: "w-24 h-24 text-white" %>
      <h3 class="h5"><%= title %></h3>
    </div>
    <p class="body-2"><%= description %></p>
  </div>

  <% if slotted?(:right_column) %>
    <div class="w-1/2 relative">
      <%= slotted :right_column %>
      <div class="absolute inset-y-0 right-0 w-1/3 bg-gradient-to-l from-black-800 to-transparent"></div>
    </div>
  <% end %>
</div>