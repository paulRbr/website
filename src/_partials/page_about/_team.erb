<%= render "with_dots_bg", classes: "pt-section pb-section2x" do %>
  <div class="container-main">
    <%= render 'section_heading', title: 'Meet the team' %>
    <% team_members = [
      { name: "Sébastien Charrier", role: "CEO", image: "sebastien-charrier.png" },
      { name: "Paul Monseu-de Bodinat", role: "Backend Engineer", image: "sebastien-charrier.png" },
      { name: "Thimy Kieu", role: "Front End Engineer", image: "sebastien-charrier.png" },
      { name: "Paul Bonaud", role: "Backend & Infrastructure engineer", image: "sebastien-charrier.png" },
      { name: "Jay Cormier", role: "Developer Experience Engineer", image: "sebastien-charrier.png" },
      { name: "Christophe Dujarric", role: "Head of Product Marketing", image: "sebastien-charrier.png" },
      { name: "Louise Loiseau", role: "HR & Administration Manager", image: "sebastien-charrier.png" },
      { name: "Florent Braure", role: "Head of Engineering", image: "sebastien-charrier.png" },
      { name: "Yoan Gross", role: "Product Manager & Product Designer", image: "sebastien-charrier.png" },
      { name: "Emmanuel Louisy-Gabriel", role: "Backend Engineer", image: "sebastien-charrier.png" },
      { name: "Aurel Dubuis", role: "Front-End Engineer", image: "sebastien-charrier.png" }
    ] %>

    <div class="grid grid-cols-3 gap-56">
      <% team_members.each do |member| %>
        <div class="flex flex-col items-center gap-8 w-full">
          <div class="flex flex-col items-center gap-16 w-full">
            <div class="rounded-24 overflow-hidden w-[104px] h-[104px] shadow-aqua-large">
              <img
                <%== image_attrs "/images/team/#{member[:image]}", {width: 104} %>
                class="w-full h-full object-cover saturate-0 opacity-80"
                alt=""
              >
            </div>
            <h3 class="h6 text-black-900 w-full text-center">
              <%= member[:name] %>
            </h3>
          </div>
          <p class="capped-small text-black-80 w-full text-center"><%= member[:role] %></p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
