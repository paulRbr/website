<div class="bg-black-900 text-white py-section2x">
  <div class="container-main">
    <div class="md:w-[36.75rem] mx-auto">
      <%= render 'section_heading', locals: {
        title: 'Why join us?',
        pill: 'pill title',
        description: 'Help us invent the tools allowing API builders to create APIs users love.',
        variant: 'dark'
      } %>
    </div>

    <div class="w-full md:max-w-[56.25rem] mx-auto">
      <div class="flex flex-col sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-24">
        <%= render "bento_item", locals: {
          title: "100% remote by design",
          description: "This needs a subtext",
          icon: "home-heart-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Safe place to work",
          description: "This needs a subtext",
          icon: "mental-health-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Competitive salary and equity",
          description: "This needs a subtext",
          icon: "money-euro-circle-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Time off: 7 weeks of holidays + work/life balance",
          description: "This needs a subtext",
          icon: "calendar-2-fill"
        } %>

        <%= render "bento_item", locals: {
          title: "Team gathering: 4 IRLs a year & micro-IRLs",
          description: "This needs a subtext",
          icon: "team-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Gear: welcome pack, choose your computer and working equipment",
          description: "This needs a subtext",
          icon: "home-gear-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Knowledge: books, trainings, coaching, conferences",
          description: "This needs a subtext",
          icon: "book-open-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Health: insurance 100% (Alan), no carence day",
          description: "This needs a subtext",
          icon: "health-book-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Personalized onboarding: tailored coaching, IRL one-to-one, buddy, welcome gift",
          description: "This needs a subtext",
          icon: "gift-line"
        } %>
      </div>


      <% images = [
        '/images/about/keyboard.png',
        '/images/about/keyboard-2.png',
      ] %>
      <% images = images.map { |image| image.gsub("src/", "") } %>
      <div class="mt-24">
        <div class="js-aboutImages flex flex-col items-center gap-24" data-current-index="0">
          <div class="w-full relative h-auto rounded-16 overflow-hidden bg-white">
            <% images.each_with_index do |image, index| %>
            <button
              type="button"
              data-why-join-us-images-index="<%= index %>"
              <% if image == images.first %>data-current="true"<% end %>
              <% if image != images.first %>aria-hidden="true"<% end %>
              class="js-openWhyJoinUsImagesDialog block w-full h-auto rounded-16 overflow-hidden
                  not-data-current:absolute not-data-current:inset-0
                  transition-opacity duration-300 opacity-100 not-data-current:opacity-0"
            >
              <img
                <%== image_attrs image, {width: 900} %>
                loading="lazy"
                alt=""
                class=""
              >
             </button>
            <% end %>
          </div>

          <div class="flex justify-center gap-16 relative z-10">
            <%= render IconButton.new("vuesax-linear-arrow-left",
              size: 14,
              variant: "seashell",
              alt: "Previous image",
              classes: "stroke-black stroke-[1.5] js-aboutImages-prev-button",
            ) %>
            <%= render IconButton.new("vuesax-linear-arrow-right",
              size: 14,
              variant: "seashell",
              alt: "Next image",
              classes: "stroke-black stroke-[1.5] js-aboutImages-next-button",
            ) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<%# see https://a11y-dialog.netlify.app/usage/markup and https://a11y-dialog.netlify.app/usage/styling to better get how
to markup and style the dialog-related elements %>
<div
  id="why-join-us-images-dialog"
  aria-label="Images slideshow"
  aria-hidden="true"
  class="group/dialog fixed z-[100] bg-black-900/50 inset-0 flex pt-32 px-8 sm:px-16 items-start md:items-center justify-center aria-hidden:hidden"
>
  <div
    data-a11y-dialog-hide
    class="fixed inset-0 backdrop-blur-4 z-[101]
    transition-opacity duration-300 opacity-0 group-not-aria-hidden/dialog:opacity-100"
  >
  </div>
  <div role="document" class="h-full w-full js-whyJoinUsImagesCarousel relative z-[102] mx-auto animate-dialog">
    <div class="js-whyJoinUsImagesCarousel-wrapper flex flex-col-reverse justify-center h-full">
      <div class="js-whyJoinUsImagesCarousel-wrapper flex justify-center gap-16 my-16 md:mt-40 relative z-10 shrink-0">
        <%= render IconButton.new("vuesax-linear-arrow-left",
          size: 14,
          variant: "seashell",
          alt: "Previous image",
          "data-carousel-prev-button": true,
          classes: "stroke-black stroke-[1.5]",
        ) %>
        <%= render IconButton.new("vuesax-linear-arrow-right",
          size: 14,
          variant: "seashell",
          alt: "Next image",
          "data-carousel-next-button": true,
          classes: "stroke-black stroke-[1.5]",
        ) %>
      </div>
      <div class="overflow-auto shrink">
        <div class="relative flex flex-col">
          <div class="relative w-full overflow-hidden">
            <button
              type="button"
              data-a11y-dialog-hide
              class="hidden group-data-current-slide/slide:flex small-link absolute top-8 right-12 md:top-32 md:right-32 cursor-pointer z-[103] items-center gap-4">
              Close <%= render Icon.new 'close-fill', classes: 'relative top-1' %>
            </button>
            <div data-carousel-track class="flex transition-transform duration-500 ease-in-out z-0">
              <% images.each_with_index do |image, index| %>
                <div
                  data-carousel-slide
                  class="group/slide relative p-16 lg:p-32 transition-transform duration-500 ease-in-out w-full shrink-0 flex flex-col gap-24"
                  <% if index === 0 %>data-current-slide<% end %>
                >
                  <img
                    <%== image_attrs image, {width: 1600} %>
                    class="object-cover"
                    loading="lazy"
                    alt=""
                  >
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
