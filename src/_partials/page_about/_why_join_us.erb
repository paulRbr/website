<div class="bg-black-900 text-white py-section2x">
  <div class="container-main">
    <div class="md:w-[36.75rem] mx-auto">
      <%= render 'section_heading', locals: {
        title: 'Why join us?',
        pill: 'A place to thrive',
        description: 'We’re not just building outstanding tools. We’re crafting an adventure worth sharing together.',
        variant: 'dark'
      } %>
    </div>

    <div class="w-full md:max-w-[56.25rem] mx-auto">
      <div class="flex flex-col sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-24">
        <%= render "bento_item", locals: {
          title: "100% remote by design",
          description: "Work from wherever you're happiest.",
          icon: "home-heart-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Safe place to work",
          description: "We care deeply about creating a respectful, welcoming space.",
          icon: "mental-health-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Fair compensation",
          description: "Competitive salary and equity for everyone.",
          icon: "money-euro-circle-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Generous time off",
          description: "7 weeks of paid time off, because rest is part of doing great work.",
          icon: "calendar-2-fill"
        } %>

        <%= render "bento_item", locals: {
          title: "Team moments",
          description: "We meet in real life 4 times a year, and more in smaller groups.",
          icon: "team-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Your gear, your way",
          description: "Choose your setup, we'll make sure you have what you need.",
          icon: "home-gear-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Keep learning",
          description: "Books, conferences, coaching, to help you grow at your own pace.",
          icon: "book-open-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Full health coverage",
          description: "100% health insurance via Alan. No carence days, ever.",
          icon: "health-book-line"
        } %>

        <%= render "bento_item", locals: {
          title: "Thoughtful onboarding",
          description: "Coaching, welcome gifts, and a buddy to guide your first steps.",
          icon: "gift-line"
        } %>
      </div>


      <% images = [
        '/images/about/irl-2024-005.jpg',
        '/images/about/irl-2020-001.jpg',
        '/images/about/irl-2023-001.jpg',
        '/images/about/irl-2024-003.jpg',
        '/images/about/irl-2024-001.jpg',
        '/images/about/irl-2024-004.jpg',
        '/images/about/irl-2023-002.jpg',
        '/images/about/irl-2024-002.jpg',
      ] %>
      <div class="mt-24">
        <div
          id="fadeshow-why-join-us"
          class="flex flex-col items-center gap-24"
          data-current-index="0"
        >
          <div class="w-full relative h-auto rounded-16 overflow-hidden bg-white">
            <% images.each_with_index do |image, index| %>
              <button
                type="button"
                data-image-index="<%= index %>"
                data-dialog-carousel-index="<%= index %>"
                data-dialog-open="dialog-why-join-us"
                <% if image == images.first %>data-current-image="true"<% end %>
                <% if image != images.first %>aria-hidden="true" tabindex="-1"<% end %>
                class="block w-full h-auto rounded-16 -outline-offset-2 overflow-hidden
                    not-data-current-image:absolute not-data-current-image:inset-0
                    transition-opacity duration-300 opacity-100 not-data-current-image:opacity-0 not-data-current-image:pointer-events-none"
              >
                <img
                  <%== image_attrs image, {width: 900} %>
                  loading="lazy"
                  alt=""
                  class="object-cover aspect-video"
                >
              </button>
            <% end %>
          </div>

          <%= render 'items_nav', locals: {
            items_id: 'fadeshow-why-join-us',
            nav_label: "Images slideshow navigation",
            prev_label: "Previous image",
            next_label: "Next image",
          } %>
        </div>
      </div>
    </div>
  </div>
</div>


<%# see https://a11y-dialog.netlify.app/usage/markup and https://a11y-dialog.netlify.app/usage/styling to better get how
to markup and style the dialog-related elements %>
<div
  id="dialog-why-join-us"
  aria-label="Images slideshow"
  aria-hidden="true"
  class="group/dialog pt-32 fixed z-[100] bg-black-900/50 inset-0 flex items-start md:items-center justify-center aria-hidden:hidden"
>
  <div
    data-a11y-dialog-hide
    class="fixed inset-0 backdrop-blur-4 z-[101]
    transition-opacity duration-300 opacity-0 group-not-aria-hidden/dialog:opacity-100"
  >
  </div>
  <div role="document" class="h-full w-full relative z-[102] mx-auto animate-dialog">
    <div data-dialog-dirty-height-fix class="flex flex-col-reverse justify-center h-full">
      <%= render 'items_nav', locals: {
        items_id: 'carousel-why-join-us',
        nav_label: "Images slideshow navigation (zoomed in)",
        prev_label: "Previous image",
        next_label: "Next image",
        default_dialog_focus: true,
        classes: 'my-16 md:mt-40',
      } %>
      <div class="overflow-auto shrink">
        <%= render 'carousel', locals: {
          id: 'why-join-us',
          before_track: capture do %>
            <button
              type="button"
              data-a11y-dialog-hide
              class="hidden group-data-current-slide/slide:flex small-link absolute top-8 right-12 md:top-32 md:right-32 cursor-pointer z-[103] items-center gap-4">
              Close <%= render Icon.new 'close-fill', classes: 'relative top-1' %>
            </button>
          <% end,
          items: images,
          item_wrapper_classes: '',
          item_label: ->(item) do %>Image <%= images.index(item) + 1 %><% end,
          item_template: ->(item) do %>
            <img
              <%== image_attrs item, {width: 1600} %>
              class="w-full h-full object-cover"
              loading="lazy"
              alt=""
            >
          <% end
        } %>
      </div>
    </div>
  </div>
</div>
