
<% grid_items = 18 %>
<% grid_posts = collections.posts.resources.slice(0, grid_items) %>
<% older_posts = (collections.posts.resources.slice(grid_items, collections.posts.resources.length - grid_items) || []) %>
<div class="container-main mb-section">
  <span role="heading" aria-level="2" class="sr-only">Recent posts</span>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-32 mx-auto w-fit">
    <% grid_posts.each do |post| %>
      <%= render 'post_excerpt', locals: {
        **post.data,
        "lvl" => 3,
        "href" => post.relative_url,
        "excerpt" => post_excerpt(markdownify(post.content)),
        "image" => defined?(post.data.image) ? '/website/images/' + post.data.image : nil
      } %>
    <% end %>
  </div>
</div>

<div class="mt-section py-section text-white bg-black-900">
  <div class="container-main">
    <div class="flex flex-col gap-32">
      <h2 class="h2">Older posts</h2>
      <div class="flex flex-col gap-12">
      <% older_posts.each do |post| %>
        <div class="
          grid grid-rows-[repeat(2,_minmax(0,_max-content))] md:grid-rows-1 grid-cols-12 items-center
          -mx-12 p-12 hover:bg-black-700 active:bg-black-900 rounded-12 transition-colors duration-300 stretched-link-container
        ">
          <p class="col-span-12 md:col-span-8 mb-8 md:mb-0">
            <a href="<%= post.relative_url %>" class="stretched-link"><%= post.data.title %></a>
          </p>
          <p class="max-md:row-start-2 col-span-6 md:col-span-2">
            <% if defined?(post.data.category) %>
              <%= render Tag.new post.data.category, variant: "pill-on-dark" %>
            <% end %>
          </p>
          <p class="max-md:row-start-2 col-span-6 md:col-span-2 text-right body-4"><%= post.data.date.strftime('%m/%d/%Y') %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
