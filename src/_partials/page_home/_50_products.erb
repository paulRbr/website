<%# Products section %>
<div class="flex flex-col gap-24">
  <%# Title and description %>
  <div class="flex flex-col gap-8 w-full">
    <h2 class="h2">Many API standards,<br>one unified experience</h2>
    <p class="body-2">Bump.sh is powered by a proprietary parsing engine allowing us to provide the exact same top-notch experience to your users, regardless the API specifications you are using.</p>
  </div>

  <%# Tags section %>
  <div class="flex flex-col gap-16 w-full">
    <%# First row of tags %>
    <div class="flex flex-wrap gap-8 w-full">
      <% [
        "OpenAPI (2.x, 3.0, 3.1)",
        "AsyncAPI (2+)",
        "JSON-schema",
        "OpenAPI overlays",
        "Markdown anywhere"
      ].each do |tag| %>
        <div class="flex items-center gap-4 px-12 py-6 rounded-[20px] bg-seashell-50">
          <%= render Icon.new "hard-drive-2-line", class: "w-12 h-12 text-black-900" %>
          <span class="text-black-900 text-[10px] leading-[1.1] font-[380]"><%= tag %></span>
        </div>
      <% end %>
    </div>

    <%# Advanced spec features section %>
    <div class="flex flex-col gap-8 w-full">
      <span class="body-4">Advanced spec features:</span>
      <div class="flex flex-wrap gap-8">
        <% [
          "polymorphism",
          "references ($ref)",
          "Vendor extensions"
        ].each do |tag| %>
          <div class="flex items-center gap-4 px-12 py-6 rounded-[20px] bg-seashell-50">
            <%= render Icon.new "hard-drive-2-line", class: "w-12 h-12 text-black-900" %>
            <span class="text-black-900 text-[10px] leading-[1.1] font-[380]"><%= tag %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>