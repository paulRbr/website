<%#
  Homepage company logos section

  Params: none
%>
<% companyLogos = [
  {
    name: 'BigId',
    image: '/images/company-logos/bigid.svg'
  },
  {
    name: 'Lightspeed',
    image: '/images/company-logos/lightspeed.svg'
  },
  {
    name: 'Elastic',
    image: '/images/company-logos/elastic.svg'
  },
  {
    name: 'Redpanda',
    image: '/images/company-logos/redpanda.svg'
  },
  {
    name: 'MongoDB',
    image: '/images/company-logos/mongodb.svg'
  },

  {
    name: 'Forto',
    image: '/images/company-logos/forto.svg'
  },
  {
    name: 'Memo Bank',
    image: '/images/company-logos/memo-bank.svg'
  },
  {
    name: 'Aviobook',
    image: '/images/company-logos/aviobook.svg'
  }
] %>
<div class="bg-white my-section2x">
  <div class="container-main">
    <div class="flex flex-col items-center w-full gap-56">
      <h2 class="capped-small text-black-600">
        Trusted by leading companies
      </h2>
      <div class="flex flex-wrap justify-center items-center w-full gap-32 md:gap-64">
        <% companyLogos.each do |companyLogo| %>
          <%= svg companyLogo[:image], class: "h-32 w-auto" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
