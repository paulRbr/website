<%#
  Homepage company logos section

  Params: none
%>
<% companyLogos = [
  {
    name: 'Lightspeed',
    image: '/images/company-logos/lightspeed.png'
  },
  {
    name: 'Memo Bank',
    image: '/images/company-logos/memo-bank.png'
  },
  {
    name: 'Motorola Solutions',
    image: '/images/company-logos/motorola-solutions.png'
  },
  {
    name: 'Elastic',
    image: '/images/company-logos/elastic.png'
  },
  {
    name: 'BigId',
    image: '/images/company-logos/big-id.png'
  },
  {
    name: 'Memo Bank',
    image: '/images/company-logos/memo-bank.png'
  },
  {
    name: 'Elastic',
    image: '/images/company-logos/elastic.png'
  },
  {
    name: 'Lightspeed',
    image: '/images/company-logos/lightspeed.png'
  },
] %>
<div class="bg-white my-section2x">
  <div class="container-main">
    <div class="flex flex-col items-center w-full gap-56">
      <h2 class="capped-small text-black-600">
        Trusted by leading companies
      </h2>
      <div class="flex flex-wrap justify-center items-center w-full gap-32 md:gap-64">
        <% companyLogos.each do |companyLogo| %>
          <img
            loading="lazy"
            <%== image_attrs companyLogo[:image], {height: 32} %>
            alt="<%= companyLogo[:name] %>"
            class="h-32 w-auto"
          >
        <% end %>
      </div>
    </div>
  </div>
</div>
