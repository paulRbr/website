<%#
  Homepage feature item

  Params (all required):
    - pill: hash with:
      - icon: icon name for the category pill shown above the title
      - text: text for the category pill shown above the title
    - title
    - content: main text, should be correctly formatted (ie in a <p> tag)
    - cta: hash with:
      - href
      - text
    - image
    - tags: array of hashes with:
      - icon: icon name for the tag. hard-drive-2-line is the default
      - text: text for the tag
%>
<div class="flex items-center gap-56">
  <div class="flex flex-1 flex-col gap-32 w-full rounded-12">
    <%= render Tag.new pill[:text], icon: pill[:icon], variant: 'pill' %>
    <div class="flex flex-col gap-8">
      <h3 class="h3 text-black-900"><%= title %></h3>
      <div class="body-2 text-black-900">
        <%= content %>
      </div>
    </div>

    <%= render Link.new cta[:text], href: cta[:href] %>
  </div>
  <div class="flex flex-col gap-8 w-[612px]">
    <div>
      <img loading="lazy" class="overflow-hidden rounded-8" src="<%= image %>" alt="">
    </div>
    <div class="flex flex-wrap gap-8">
      <% tags.each do |tag| %>
        <%= render Tag.new tag[:text], icon: tag[:icon] || 'hard-drive-2-line', variant: 'seashell' %>
      <% end %>
    </div>
  </div>
</div>