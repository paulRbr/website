<%#
  Homepage hero section

  Params: none
%>
<div class="flex flex-col items-center justify-center gap-24 w-[32.75rem] mx-auto my-section">
  <div class="flex flex-col items-center w-full gap-2">
    <div class="flex justify-center gap-12 w-[31.8125rem]">
      <%# The aria-label is there to prevent screen reader from stoping on each part of the dom to read the headline. Not a very good practice, but better than nothing. %>
      <h1 class="flex gap-[1ch] items-center" aria-label="Stunning A.P.I. doc, made easy.">
        <span class="h1">Stunning</span>
        <div class="flex gap-4 items-center">
          <div class="flex items-center gap-4 px-16 py-[5px] rounded-[10px] bg-aqua-100 border border-aqua-400">
            <span class="h1 vfont-regular text-[3.5rem]">API doc</span>
          </div>
          <span class="h1 vfont-regular">,</span>
        </div>
      </h1>
    </div>
    <span class="h1">made easy.</span>
  </div>

  <div class="flex flex-col items-center w-full gap-40">
    <p class="body-1 text-black-800 text-center">
      Publish your entire API catalog in a beautifully-designed library that automatically stays up-to-date.
    </p>

    <div class="flex justify-center items-center gap-16">
      <a href="/demo" class="flex justify-center items-center gap-8 px-20 py-16 rounded-pill bg-black-900 text-white">
        <span class="cta">Get a demo</span>
        <%= render Icon.new 'arrow-right-up-line', size: 16 %>
      </a>
      <a href="/signup" class="flex justify-center items-center p-2 rounded">
        <span class="cta text-black-900">Sign up</span>
      </a>
    </div>
  </div>
</div>
