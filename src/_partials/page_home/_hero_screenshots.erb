<%#
  Homepage screenshot carousel section

  Params: none
%>
<% features = [
  {
    title: 'API Doc',
    image: '/images/hero/api-doc.png',
    icon: 'file-text-line',
  },
  {
    title: 'API Explorer',
    image: '/images/hero/api-explorer.png',
    icon: 'search-eye-line',
  },
  {
    title: 'Automatic changelog',
    image: '/images/hero/automatic-changelog.png',
    icon: 'exchange-box-line',
  },
  {
    title: 'Hub',
    image: '/images/hero/hub.png',
    icon: 'apps-2-line',
  }
] %>
<div class="js-heroScreenshots flex flex-col-reverse items-center gap-24 w-full my-section">
  <%# start with the buttons in the DOM for better screen reader experience %>
  <div class="flex p-4 rounded-12 bg-aqua-200 border border-aqua-300 gap-4 relative">
    <div class="js-heroScreenshots-slidingBackground z-0 absolute bottom-4 top-4 left-4 transition-all duration-300 rounded-8 bg-white"></div>

    <% features.each_with_index do |feature, index| %>
      <button
        class="flex relative z-10 justify-center items-center gap-8 px-24 py-6 rounded-8"
        data-index="<%= index %>"
        <% if feature == features.first %>data-current="true"<% end %>
      >
        <%= render Icon.new feature[:icon], size: 18  %>
        <span class="body-3 vfont-medium text-black-900"><%= feature[:title] %></span>
      </button>
    <% end %>
  </div>

  <%# Browser window with shadow effect and titlebar with dots. Easier to have this in HTML/CSS rather than in the image for visually better transitions %>
  <div class="flex flex-col w-full rounded-16 overflow-hidden shadow-strong-shadow">
    <%# Browser toolbar %>
    <div class="flex flex-col w-full bg-black-900 px-16 py-8 h-32">
      <%# Browser controls (dots) %>
      <div class="flex items-center gap-[4.97px] pt-[4.97px]">
        <div class="w-[7.46px] h-[7.46px] rounded-[3.73px] bg-white"></div>
        <div class="w-[7.46px] h-[7.46px] rounded-[3.73px] bg-white"></div>
        <div class="w-[7.46px] h-[7.46px] rounded-[3.73px] bg-white"></div>
      </div>
    </div>
    <%# Browser content area %>
    <div class="flex flex-col justify-center items-center w-full bg-black-900 rounded-b-8 px-12 pb-12">
      <div class="w-full relative h-auto rounded-16 overflow-hidden bg-white">
        <% features.each_with_index do |feature, index| %>
          <img
            src="<%= feature[:image] %>"
            alt="Bump.sh is your <%= feature[:title] %>"
            class="
              w-full h-auto rounded-16 overflow-hidden
              not-data-current:absolute not-data-current:inset-0
              transition-opacity duration-300 opacity-100 not-data-current:opacity-0
            "
            data-index="<%= index %>"
            <% if feature == features.first %>data-current="true"<% end %>
            <% if feature != features.first %>aria-hidden="true"<% end %>
          />
        <% end %>
      </div>
          </div>
        </div>