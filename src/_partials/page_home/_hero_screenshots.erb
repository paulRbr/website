<%#
  Homepage screenshot carousel section

  Params: none
%>
<% features = [
  {
    title: 'API Doc',
    image: '/images/hero/api-doc.png',
    icon: 'file-text-line',
  },
  {
    title: 'API Explorer',
    image: '/images/hero/api-explorer.png',
    icon: 'search-eye-line',
  },
  {
    title: 'Automatic changelog',
    image: '/images/hero/automatic-changelog.png',
    icon: 'exchange-box-line',
  },
  {
    title: 'Hub',
    image: '/images/hero/hub.png',
    icon: 'apps-2-line',
  }
] %>
<div
  id="fadeshow-hero"
  class="flex flex-col-reverse items-center gap-24 w-full my-section"
  data-current-index="0"
>
  <%# start with the buttons in the DOM for better screen reader experience %>
  <%= render 'sliding_buttons', locals: {
    items_id: 'fadeshow-hero',
    nav_label: 'Screenshots navigation',
    classes: 'bg-aqua-200 border border-aqua-300',
    initial_index: 0,
    items: features.map { |item| { name: item[:title], icon: item[:icon] } }
  } %>

  <%# Browser window with shadow effect and titlebar with dots. Easier to have this in HTML/CSS rather than in the image for visually better transitions %>
  <div class="w-full rounded-8 md:rounded-16 overflow-hidden" style="box-shadow: 0px 0px 50px 10px rgba(173, 225, 239, 0.45);">
    <%# Browser toolbar %>
    <div class="flex flex-col w-full bg-black-900 px-8 md:px-16 py-2 md:py-8 md:h-32">
      <%# Browser controls (dots) %>
      <div class="flex items-center gap-[4.97px] pt-4 md:pt-[4.97px]">
        <div class="w-4 h-4 rounded-8 md:w-[7.46px] md:h-[7.46px] md:rounded-[3.73px] bg-white"></div>
        <div class="w-4 h-4 rounded-8 md:w-[7.46px] md:h-[7.46px] md:rounded-[3.73px] bg-white"></div>
        <div class="w-4 h-4 rounded-8 md:w-[7.46px] md:h-[7.46px] md:rounded-[3.73px] bg-white"></div>
      </div>
    </div>
    <%# Browser content area %>
    <div class="flex flex-col justify-center items-center w-full bg-black-900 rounded-b-8 p-2 md:pt-2 md:px-12 md:pb-12">
      <div class="w-full relative h-auto rounded-8 md:rounded-16 overflow-hidden bg-white">
        <% features.each_with_index do |feature, index| %>
          <div
            role="tabpanel"
            id="fadeshow-hero-tabpanel-<%= index %>"
            aria-labelledby="fadeshow-hero-tab-<%= index %>"
            data-image-index="<%= index %>"
            style="will-change: opacity"
            class="
              not-data-current-image:absolute not-data-current-image:inset-0
              not-data-current-image:pointer-events-none
              not-data-current-image:opacity-0 opacity-100 transition-opacity duration-300
            "
            <% if index == 0 %>
              data-current-image="true"
            <% else %>
              aria-hidden="true"
            <% end %>
          >
            <img
              <%== image_attrs feature[:image], {width: 1094} %>
              <% if index == 0 %>
                fetchpriority="high"
              <% end %>
              alt="Bump.sh is your <%= feature[:title] %>"
              class="w-full h-auto rounded-8 md:rounded-16 overflow-hidden"
            />
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
