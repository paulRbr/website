<%#
  Homepage testimonials section

  Params: none
%>
<%# Note if we want to lower the component margin: watch out for the big internal shadows that might clip when the margin is too low %>
<div class="flow-root my-section2x">
  <div class="container-main">
    <%= render 'section_heading', locals: {
      title: 'Bump.sh in action',
      pill: 'Our customer stories',
      description: 'See how teams are using Bump.sh to improve their API documentation workflow'
    } %>
  </div>
  <div data-carousel class="relative flex flex-col">
    <%# the margin/padding trick is there so that internal shadows don't clip %>
    <div class="relative w-full overflow-hidden -my-shadow-aqua-medium py-shadow-aqua-medium">
      <%# left and right white to transparent gradients, taking into account the wide internal shadows %>
      <div class="hidden lg:block absolute -top-shadow-aqua-medium -bottom-shadow-aqua-medium left-0 w-[20rem] pointer-events-none z-20" style="background-image: linear-gradient(to right, #fff, transparent);"></div>
      <div class="hidden lg:block absolute -top-shadow-aqua-medium -bottom-shadow-aqua-medium right-0 w-[20rem] pointer-events-none z-20" style="background-image: linear-gradient(to left, #fff, transparent);"></div>

      <div data-carousel-track class="flex transition-transform duration-500 ease-in-out z-0">
        <%= render "page_home/testimonials_item", locals: {
          company: {
            name: 'Big Id',
            image: '/images/company-logos/big-id.png',
          },
          person: {
            name: 'Manuel Ems',
            image: '/images/testimonials/big-id.png',
            tag: '@company'
          },
          href: '/product',
        } do %>
          <p>"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."</p>
        <% end %>

        <%= render "page_home/testimonials_item", locals: {
          company: {
            name: 'Memo Bank',
            image: '/images/company-logos/memo-bank.png',
          },
          person: {
            name: 'ThisGuy HasASuperLongName',
            image: '/images/testimonials/big-id.png',
            tag: '@CTO of very long company name'
          },
          href: '/product',
        } do %>
          <p>"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."</p>
        <% end %>

        <%= render "page_home/testimonials_item", locals: {
          company: {
            name: 'Elastic',
            image: '/images/company-logos/elastic.png',
          },
          person: {
            name: 'John Doe',
            image: '/images/testimonials/big-id.png',
            tag: '@company'
          },
          href: '/product',
        } do %>
          <p>"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."</p>
        <% end %>

        <%= render "page_home/testimonials_item", locals: {
          company: {
            name: 'Elastic',
            image: '/images/company-logos/elastic.png',
          },
          person: {
            name: 'John Doe',
            image: '/images/testimonials/big-id.png',
            tag: '@company'
          },
          href: '/product',
        } do %>
          <p>"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."</p>
        <% end %>
      </div>
    </div>

    <div class="flex justify-center gap-16 mt-40 relative z-10">
      <%= render IconButton.new("vuesax-linear-arrow-left",
        size: 14,
        variant: "seashell",
        alt: "Previous testimony",
        "data-carousel-prev-button": true,
        classes: "stroke-black stroke-[1.5]",
      ) %>
      <%= render IconButton.new("vuesax-linear-arrow-right",
        size: 14,
        variant: "seashell",
        alt: "Next testimony",
        "data-carousel-next-button": true,
        classes: "stroke-black stroke-[1.5]",
      ) %>
    </div>
  </div>
</div>
