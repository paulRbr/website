        <%= render Icon.new("vuesax-linear-arrow-left", class: "stroke-black stroke-[1.5]") %>
      </button>
      <button type="button" class="w-40 h-40 flex items-center justify-center bg-[#FEE1DA] rounded-full hover:bg-seashell-400 transition-colors duration-200" aria-label="Next slide" data-carousel-next>
