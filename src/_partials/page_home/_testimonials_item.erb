<%# DOM order is a bit different than visual order for better screen reader experience %>
<div
  data-carousel-slide
  role="tabpanel"
  aria-label="<%= company[:name] %> testimony"
  <% if locals[:is_initial_slide] %>
    data-current-slide
  <% end %>
  class="transition-transform duration-500 ease-in-out w-[90%] md:w-[45rem] shrink-0 h-auto flex flex-col md:flex-row-reverse gap-32 bg-white border border-black-100 rounded-12 p-32 shadow-aqua-medium scale-90 data-current-slide:scale-100 not-data-current-slide:cursor-pointer"
>
  <div class="flex flex-col gap-24">
    <%# we give screen reader context with a visually hidden heading before the content %>
    <span role="heading" aria-level="3" class="sr-only"><%= company[:name] %> testimony</span>
    <div class="md:hidden bg-black-100 rounded-8 p-8 md:p-16 flex justify-center items-center">
      <%= render 'company_logo', locals: {
        image: company[:image],
        height: 24,
        classes: 'h-24'
      } %>
    </div>
    <div class="body-2 md:body-1"><%= content %></div>
    <%= render 'person_avatar', name: person[:name], tag: person[:tag], image: person[:image] %>
    <div class="md:hidden">
      <%= render Link.new 'Read more', href: href %>
    </div>
  </div>

  <div class="hidden md:block h-full w-1 bg-black-50 shrink-0"></div>

  <div class="hidden md:flex flex-col justify-between shrink-0">
    <div class="bg-black-100 rounded-8 p-16 flex justify-center items-center">
      <%= render 'company_logo', locals: {
        image: company[:image],
        height: 24,
        classes: 'h-24'
      } %>
    </div>
    <div class="mt-32">
      <%= render Link.new 'Read more', href: href %>
    </div>
  </div>
</div>
