<%#
  Homepage workflow section

  Params: none
%>
<div class="container-main my-section2x">
  <%= render 'section_heading', locals: {
    title: 'Modern workflow',
    pill: 'Doc-as-code',
    description: 'Include Bump.sh as a component of your stack, from your CI to your dev docs and dev rel. Keep your existing tools and level-up your game.'
  } %>

  <div class="relative">
    <div class="hidden lg:block h-1 w-9/12 m-auto absolute z-0 top-32 left-0 right-0" style="background-image: linear-gradient(to right, transparent, var(--color-black-400), transparent);"></div>

    <div class="relative z-10 flex flex-col lg:flex-row justify-stretch items-stretch gap-24 w-full">
      <%= render "page_home/workflow_step", locals: {
        number: "01",
        title: "Commit",
        subtitle: "API contract as the source of truth",
        features: [
          "Swagger, OpenAPI & AsyncAPI support",
          "Code-first and design-first",
          "Git-centered workflow"
        ],
        image: "/website/images/workflow/commit.png"
      } %>

      <%= render "page_home/workflow_step", locals: {
        number: "02",
        title: "Review",
        subtitle: "Top-notch collaboration & governance",
        features: [
          "Code review assistance",
          "Breaking changes notification",
          "Doc preview"
        ],
        image: "/website/images/workflow/review.png"
      } %>

      <%= render "page_home/workflow_step", locals: {
        number: "03",
        title: "Publish",
        subtitle: "Release control",
        features: [
          "Automatic doc & changelog update",
          "Release management & rollback",
          "Customers notification"
        ],
        image: "/website/images/workflow/publish.png"
      } %>
    </div>
  </div>

  <%
  #<div class="flex justify-center items-center mt-48">
  #  <%= render Link.new "Check out our product page to learn more", href: "/product"
  #</div>
  %>
</div>
