<%#
  Homepage workflow step item

  Params (all required):
    - number: step number to show in a pill (01, 02, 03)
    - title: step title
    - subtitle: step subtitle
    - features: array of feature strings that will be rendered as a list of checkboxes
%>
<div class="flex flex-auto flex-row lg:flex-col sm:justify-center items-start lg:items-center gap-12 lg:gap-8">
  <div aria-hidden="true" class="flex justify-center items-center leading-none rounded-pill bg-seashell-300 p-16 sm:p-24">
    <span class="h6 leading-none text-black-900"><%= number %></span>
  </div>

  <div class="flex grow flex-col justify-between gap-32 p-24 max-w-[22.3125rem] bg-black-50 text-black-900 rounded-12">
    <div class="flex flex-col gap-32">
      <div class="flex flex-col gap-24">
        <div class="flex flex-col gap-8">
          <h3 class="h5"><span class="sr-only"><%= number %>.&nbsp;</span><%= title %></h3>
          <p class="body-2"><%= subtitle %></p>
        </div>

        <ul role="list" class="flex flex-col gap-8">
          <% features.each do |feature| %>
            <li class="flex gap-4 items-center rounded-32 w-full">
              <span class="flex items-center gap-8 pt-2">
                <%= render Icon.new "checkbox-circle-fill", class: "text-black-800" %>
              </span>
              <span class="body-3"><%= feature %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <img
        loading="lazy"
        <%== image_attrs image, {width: 309} %>
        alt=""
      >
    </div>
  </div>
</div>
