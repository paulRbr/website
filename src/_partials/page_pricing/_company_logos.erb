<%#
  Pricing page company logos section

  Params: none
%>
<% companyLogos = [
  {
    name: 'Lightspeed',
    image: '/website/images/company-logos/lightspeed.svg'
  },
  {
    name: 'Elastic',
    image: '/website/images/company-logos/elastic.svg',
    height: 40
  },
  {
    name: 'MongoDB',
    image: '/website/images/company-logos/mongodb.svg'
  },
  {
    name: 'Redpanda',
    image: '/website/images/company-logos/redpanda.svg',
    height: 24,
    extra_classes: 'top-2'
  }
] %>
<div class="bg-black-900 text-black-100">
  <div class="flex flex-col sm:items-center w-full gap-24">
    <h3 class="capped-small text-black-100">
      Trusted by leading companies
    </h3>
    <div class="flex flex-wrap sm:justify-center sm:items-center w-full gap-24 fill-white">
      <% companyLogos.each do |companyLogo| %>
        <%= render 'company_logo', locals: {
          image: companyLogo[:image],
          label: companyLogo[:name],
          height: companyLogo[:height] || 32,
          classes: "fill-none #{companyLogo[:extra_classes]}"
        } %>
      <% end %>
    </div>
  </div>
</div>
