<%#
  Pricing page company logos section

  Params: none
%>
<% companyLogos = [
  {
    name: 'Lightspeed',
    image: '/images/company-logos/lightspeed-dark.png'
  },
  {
    name: 'Memo Bank',
    image: '/images/company-logos/memo-bank-dark.png'
  },
  {
    name: 'Big ID',
    image: '/images/company-logos/big-id-dark.png'
  },
  {
    name: 'Elastic',
    image: '/images/company-logos/elastic-dark.png'
  }
] %>
<div class="bg-black-900 text-black-100">
  <div class="container-main">
    <div class="flex flex-col items-center w-full gap-24">
      <h3 class="capped-small text-black-100">
        Trusted by leading companies
      </h3>
      <div class="flex flex-wrap justify-center items-center w-full gap-24">
        <% companyLogos.each do |companyLogo| %>
          <img
            <%== image_attrs companyLogo[:image], {height: 32} %>
            alt="<%= companyLogo[:name] %>"
            class="h-24 w-auto"
          >
        <% end %>
      </div>
    </div>
  </div>
</div>
