<%# Pricing plans summary section %>
<div class="js-plansSummary flex flex-col items-center gap-40 lg:w-[56.25rem] mx-auto">
  <%= render 'sliding_buttons', locals: {
    items_id: 'carousel-plans-summary',
    nav_label: 'Plans navigation',
    classes: 'lg:hidden bg-black-800 border border-black-700',
    text_classes: 'text-white! group-data-current:text-black-900!',
    initial_index: nil,
    items: items.map { |item| { name: item[:name] } }
  } %>

  <div
    id="carousel-plans-summary"
    data-carousel-track-container
    class="
      w-full relative
      <%# the padding bottom trick is there to have the highlighted plan button box shadow bleed out of the overflow hidden container %>
      max-lg:overflow-hidden -mb-40 pb-40
      <%# we wait for carousel to be initialized before rendering to prevent showing non-highlighted plan for a few ms on load %>
      opacity-0 data-initialized:opacity-100 lg:opacity-100!
    "
  >
    <div
      data-carousel-track
      style="transform: translate3d(0px, 0px, 0px)"
      class="flex will-change-transform motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-in-out z-0
      lg:grid lg:grid-cols-3 lg:gap-24 lg:transform-none!"
    >
      <% items.each_with_index do |item, index| %>
        <%= render "page_pricing/plans_summary_item", **item, index: index, highlight: index == highlight_item_index %>
      <% end %>
    </div>
  </div>

  <div class="px-16 lg:px-0 w-full">
    <p class="bg-black-700 text-white body-3 flex flex-col items-center sm:flex-row gap-8 py-16 px-24 rounded-32 w-full">
      <span class="inline-flex justify-center items-center gap-4">
      <%= render Icon.new "heart-3-fill", size: 17, class: "text-aqua-500"%>
      <span class="h6">Support:</span>
    </span>
      <span>We believe our stellar support makes a world of a difference. No matter what plan you're on, you get full (Human) support.</span>
    </p>
  </div>
</div>