<% borderStyles = 'max-lg:border-t max-lg:border-t-black-500 max-lg:border-black-200 lg:border-b lg:border-black-200 max-lg:bg-black-50' %>
<% id = 'pricing-category-' + title.downcase.gsub(' ', '-') %>
<tr>
  <th id="<%= id %>" colspan="3" class="
    js-dirtySizing text-left p-12 h-64 capped-small flex items-center gap-8 max-lg:w-[1000px]
    <%= borderStyles %>
  ">
    <%= render Icon.new icon, class: "text-aqua-800" %>
    <%= title %>
  </th>
  <td class="max-lg:hidden <%= borderStyles %>" aria-hidden="true"></td>
  <td class="max-lg:hidden <%= borderStyles %>" aria-hidden="true"></td>
  <td class="max-lg:hidden <%= borderStyles %>" aria-hidden="true"></td>
</tr>

<% features.each do |feature| %>
  <%= render 'page_pricing/plan_details/feature_row', locals: {
    title: feature[:title],
    cols: feature[:cols],
    category_id: id
  } %>
<% end %>
