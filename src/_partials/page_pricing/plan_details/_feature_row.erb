<tr>
  <th scope="row" <%=raw defined?(category_id) ? "headers=\"#{category_id}\"" : '' %> class="text-left body-3 p-12 h-64 border-b border-black-200"><%= title %></th>
  <% cols.each do |column| %>
    <% if column === false %>
      <td class="text-center p-12 border-b border-black-200"><span class="sr-only">Not included</span></td>
    <% elsif column === true %>
      <td class="text-center p-12 border-b border-black-200"><%= render Icon.new 'checkbox-circle-fill', alt: 'Included', size: 18, classes: 'mx-auto' %></td>
    <% else %>
      <td class="text-center p-12 body-3 border-b border-black-200"><%= column %></td>
    <% end %>
  <% end %>
</tr>