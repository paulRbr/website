---
layout: default
with_navbar_padding: false
dark_header: true
---
<div class="bg-black-900">
  <%= render "with_dots_bg",
    classes: "-mt-navbar pt-navbar bg-black-900",
    offset: "10px" do %>
      <div class="mt-section container-main">
        <%= render "section_heading", locals: {
          title: "Pricing",
          variant: "dark",
          lvl: 1
        } do %>
          <%= render "page_pricing/company_logos" %>
        <% end %>
      </div>
  <% end %>

  <div class="lg:container-main">
    <div class="bg-black-900 pb-section">
      <%= render "page_pricing/plans_summary", items: [
        {
          name: "Basic",
          price: "Free",
          description: "For solo API builders who want their API to shine.",
          features_description: "Our basic plan features:",
          features: [
            "OpenAPI, AsyncAPI & Overlays",
            "Seamless single page experience",
            "Full CI integration",
            "Custom domain and logo",
            "1 API doc, 10 guests, 1 user",
            "Auto-changelog: 5 last entries",
          ],
          cta: {
            text: "Get started",
            href: "/signup",
          }
        },
        {
          name: "Pro",
          price: 249,
          description: "For API teams who care about clean delivery and access control.",
          features_description: "Everything in Basic, plus:",
          features: [
            "Branches management",
            "API Explorer",
            "Release rollback",
            "Unlimited internal users",
            "10 API docs, 50 guests",
            "Auto-changelog: 1 year retention",
          ],
          cta: {
            text: "Start 14-day free trial",
            href: "/signup",
          }
        },
        {
          name: "Enterprise",
          price: "Custom",
          highlight: true,
          description: "For companies who manage complex API and ecosystems at scale.",
          features_description: "Everything in Pro, plus:",
          features: [
            "Single Sign-On (SSO)",
            "Manual releases",
            "Advanced integration",
            "Custom reports and analytics",
            "Custom # of API docs & guests",
            "Priority feature requests",
          ],
          cta: {
            text: "Request demo",
            href: calendly_url,
          }
        }
      ] %>
    </div>
  </div>
</div>

<%= render "page_pricing/plans_details" %>

<% slot :scripts do %>
  <script src="/website<%= asset_path 'javascript/pages/pricing/index.js' %>"></script>
<% end %>
