---
layout: default
with_navbar_padding: false
dark_header: true
---
<div class="bg-black-900">
  <%= render "with_dots_bg",
    classes: "-mt-navbar pt-navbar bg-black-900",
    offset: "10px" do %>
      <div class="mt-section container-main">
        <%= render "section_heading", locals: {
          title: "Pricing",
          description: "Adapted to your company’s size and needs.",
          variant: "dark",
          lvl: 1
        } do %>
          <%= render "page_pricing/company_logos" %>
        <% end %>
      </div>
  <% end %>

  <div class="lg:container-main">
    <div class="bg-black-900 pb-section">
      <%= render "page_pricing/plans_summary", items: [
        {
          name: "Basic",
          price: "Free",
          description: "Get a stunning API doc online in seconds",
          features_description: "Our basic plan features:",
          features: [
            "OpenAPI + AsyncAPI support",
            "OpenAPI Overlay",
            "Seamless single page experience",
            "CLI, API & GitHub action integration",
            "Custom domain + logo",
            "1 API doc, 1 user, 10 guests",
            "Automatic changelog: 5 last entries",
          ],
          cta: {
            text: "Get started",
            href: "/signup",
          }
        },
        {
          name: "Standard",
          price: 249,
          description: "Showcase and share all your API docs",
          features_description: "Everything in Basic, plus:",
          features: [
            "Advanced access management",
            "Release rollback",
            "Custom color, favicon & meta image",
            "Branches management",
            "API Explorer",
            "10 API docs, 1 Hub, 50 guests, unlimited internal users",
            "Automatic changelog: unlimited",
          ],
          cta: {
            text: "Start 14-day free trial",
            href: "/signup",
          }
        },
        {
          name: "Enterprise",
          price: "Custom",
          highlight: true,
          description: "Handle complex API docs needs at scale",
          features_description: "Everything in Pro, plus:",
          features: [
            "Single Sign-On (SSO)",
            "Manual releases & release notes",
            "Advanced customization and integration",
            "Custom reports and analytics",
            "Custom number of API docs, Hubs & guests",
            "Dedicated onboarding sessions",
            "Priority feature requests",
          ],
          cta: {
            text: "Request demo",
            href: "/signup",
          }
        }
      ] %>
    </div>
  </div>
</div>

<%= render "page_pricing/plans_details" %>

<% slot :scripts do %>
  <script src="<%= asset_path 'javascript/pages/pricing/index.js' %>"></script>
<% end %>
